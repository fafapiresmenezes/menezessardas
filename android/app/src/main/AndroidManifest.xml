<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Três controles do MASVS escritos aqui de propósito, conferidos por
         src/lib/geo/nativo.test.ts (a prova lê este arquivo):
           allowBackup="false"      — o Android não copia os dados deste app para a nuvem do
                                      Google nem para o adb backup. Era "true", que é o padrão
                                      do Capacitor, e deixava o bloco cifrado do cofre sair do
                                      aparelho: contradizia a promessa do app.
           dataExtractionRules      — o mesmo, no Android 12 e acima, inclusive na troca de
                                      celular (o allowBackup sozinho não cobre isso).
           networkSecurityConfig    — nenhuma conexão em texto claro, de endereço nenhum. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regras_sem_copia"
        android:networkSecurityConfig="@xml/rede_segura"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissões. Só o estritamente necessário para o MVP de geomapeamento, e cada uma
         é pedida ao titular na hora de usar. Nada de contatos, microfone, armazenamento
         ou identificadores de aparelho. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- G2: gravar a posição do próprio titular. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- G4: a câmera como sensor de LUGAR. A imagem não é guardada nem enviada;
         só sai o tipo de ambiente. Não há modelo de rosto, emoção ou identidade. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
